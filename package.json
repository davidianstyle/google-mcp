{
  "name": "@davidianstyle/google-mcp",
  "version": "0.2.0",
  "description": "Consolidated Google MCP server — Gmail, Calendar, Meet, Drive, Docs, Sheets, Slides in one process.",
  "type": "module",
  "bin": {
    "google-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "google",
    "gmail",
    "calendar",
    "drive",
    "slides"
  ],
  "author": "David Chang",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
